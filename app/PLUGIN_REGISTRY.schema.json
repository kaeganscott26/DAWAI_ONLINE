{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawai.local/schemas/plugin-registry.schema.json",
  "title": "DawAI Plugin Registry",
  "type": "object",
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dawai_plugin_registry_v1"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "builtin", "theme_locked"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["EQ", "COMPRESSOR", "SATURATION", "REVERB", "DELAY", "UNKNOWN"]
          },
          "builtin": {
            "type": "boolean"
          },
          "theme_locked": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
